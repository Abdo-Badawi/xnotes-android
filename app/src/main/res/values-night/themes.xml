<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The launch theme by night: the same navy launch stage, with light bar icons on it. -->
    <style name="Theme.Xnotes.Splash" parent="Theme.Xnotes">
        <item name="android:windowBackground">@drawable/pixora_launch_background</item>
        <item name="android:statusBarColor">@color/pixora_splash_background</item>
        <item name="android:navigationBarColor">@color/pixora_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/pixora_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/pixora_splash_icon</item>
    </style>
</resources>
